# Скопируй в .env и заполни.

# Токен бота от @BotFather
BOT_TOKEN=

# ИИ (любой OpenAI-совместимый API)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aura_ai
DB_USER=aura_bot
DB_PASSWORD=

# Как часто проверять оценки, минут
GRADE_CHECK_INTERVAL_MINUTES=15

# 1 — показывать окно браузера при /grades, чтобы вручную пройти капчу.
# На сервере должно быть 0.
PLATONUS_SHOW_BROWSER=0

# Пауза перед каждым действием браузера, мс — чтобы успеть рассмотреть шаги.
PLATONUS_SLOW_MO=0

# Часовой пояс по умолчанию для напоминаний
DEFAULT_TIMEZONE=Asia/Almaty

# Язык сводок по оценкам по умолчанию: kk (казахский) или ru
DEFAULT_LANGUAGE=kk

# Mini App: порт локального сервера (0 — выключить)
WEBAPP_PORT=8080
# 127.0.0.1 на компьютере, 0.0.0.0 в Docker
WEBAPP_HOST=127.0.0.1
# Постоянный https-адрес Mini App на сервере (например https://aura.example.kz)
WEBAPP_URL=
# 1 — временный Cloudflare Tunnel для теста (нужен cloudflared)
WEBAPP_TUNNEL=0

# Для ручной проверки парсера: python parser.py
PLATONUS_LOGIN=
PLATONUS_PASSWORD=
